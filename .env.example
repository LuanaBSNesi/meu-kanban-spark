# Neon Postgres — fonte da verdade do kanban.
# Painel do Neon > seu projeto > Connect > use a string "pooled" (host com -pooler).
DATABASE_URL="postgresql://usuario:senha@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Google Sheets — usado apenas pelo script de importacao unica.
# Pode ser removido depois que os dados estiverem no Neon.
GOOGLE_CLIENT_EMAIL=""
GOOGLE_PRIVATE_KEY=""
SPREADSHEET_ID=""

# OAuth Google — login do app, acesso ao Drive e identidade do servidor MCP.
# Google Cloud Console > APIs e servicos > Credenciais > ID do cliente OAuth 2.0.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Unico e-mail autorizado a usar o app e o endpoint MCP.
OWNER_EMAIL="baggio.lps@gmail.com"
